# Bu dosyayı kopyalamana gerek yok: Sakura değerleri Windows ortam değişkenlerinden okur.
# Örnek: setx SAKURA_TELEGRAM_TOKEN "123456:ABC..."

# BotFather'dan alınan Telegram bot anahtarı
SAKURA_TELEGRAM_TOKEN=

# Uzun işlerin (is_ver.py) varsayılan çalışma klasörü; boşsa proje klasörü
SAKURA_IS_KLASORU=

# Karakter araçlarının (karakter/) kullandığı çizim klasörü
SAKURA_CIZIM_KLASORU=
